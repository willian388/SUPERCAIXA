# Configurações do SuperCaixa
PORT=3000
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Caminho do banco de dados SQLite (relativo à raiz do projeto)
DB_PATH=./data/supercaixa.db

# ===== Autenticação com Google (OPCIONAL) =====
# Descomente e preencha para habilitar login com Google via OAuth2.
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=seu-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback